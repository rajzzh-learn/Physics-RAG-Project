# ── LLM Provider ──────────────────────────────────────────────────────────
# Set to "openai" or "watsonx"
LLM_PROVIDER=openai

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── IBM watsonx.ai (use if LLM_PROVIDER=watsonx) ──────────────────────────
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# ── Embedding model (HuggingFace, runs locally — no API key needed) ────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval settings ─────────────────────────────────────────────────────
RETRIEVER_TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# -- Groq (use if LLM_PROVIDER=groq) ----------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Vision model used when an image is attached (Groq provider only)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Google Gemini (required for image/vision analysis — free tier) ─────────
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
