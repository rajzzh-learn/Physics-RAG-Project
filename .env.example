# ── LLM Provider ──────────────────────────────────────────────────────────
# Set to "openai" or "watsonx"
LLM_PROVIDER=openai

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── IBM watsonx.ai (use if LLM_PROVIDER=watsonx) ──────────────────────────
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# ── Embedding model (HuggingFace, runs locally — no API key needed) ────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval settings ─────────────────────────────────────────────────────
RETRIEVER_TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120
